 

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <title> 登录</title>
    <link href="/zlineauthrize/pzlplugins/hdesk/css/bootstrap.min.css" rel="stylesheet">
    <link href="/zlineauthrize/pzlplugins/hdesk/css/font-awesome.min.css?v=4.4.0" rel="stylesheet">
    <link href="/zlineauthrize/pzlplugins/hdesk/css/animate.min.css" rel="stylesheet">
    <link href="/zlineauthrize/pzlplugins/hdesk/css/style.min.css" rel="stylesheet">
    <link href="/zlineauthrize/pzlplugins/hdesk/css/login.min.css" rel="stylesheet">
    <!--[if lt IE 8]>
    <meta http-equiv="refresh" content="0;ie.html" />
    <![endif]-->
    <script>
        if(window.top!==window.self){window.top.location=window.location};
    </script>
        <script src="/zlineauthrize/static/jquery.min.js" type="text/javascript"></script>
     <script src="/zlineauthrize/pzlplugins/hdesk/js/bootstrap.min.js?v=3.3.6"></script>
 <script src="/zlineauthrize/static/pzlsecurity.js" Type="text/javascript"></script>
<script>
    $(function () {
        $("#loginBtn").click(function () {
          var xtoken= $("#XToken").val();
        var userid = $("#pzlusername").val();
        var pass = $("#pzlpassword").val();
        
        if ((pass == "") || (userid == "")) { alert("请输入密码"); return false; }
        var data = {XToken:xtoken,pzlusername:userid,pzlpassword:pass};
       
     //   alert("加密前数据:"+ JSON.stringify(data));

        var result = $.encryptRequest({
                data: data
        });
       // var ww = "";
 //alert("加密后数据:"+ JSON.stringify(result));
         $.post('/zlineauthrize/xlogin/sysxlogin',result, function (res)
      
         {
             res = JSON.parse(res);
             if (res.succeed==1) {
                 window.location.href = "https://www.hsys.pudong-edu.sh.cn/infomng/images/pic2.gif??r="+xtoken;
               //  ww = "yy";
             } else {
                 alert(res.errorMsg);
                  return false;
             }
         })
          //  alert(ww);
        return true;
        });

         $("#PhoneCodeBtn").click(function () {
          var xtoken= $("#XToken").val();
        var phone = $("#pzlphone").val();
        
        
        if (phone == "") { alert("请输入手机号"); return false; }
             var data = {XToken:xtoken,xphone:phone};
    
      
       // var ww = "";
 //alert("加密后数据:"+ JSON.stringify(result));
         $.post('/zlineauthrize/xlogin/phonelogin?act=getcode',data, function (res)
      
         {
             res = JSON.parse(res);
             if (res.succeed==1) {
                 alert(res.errorMsg);
                 time($("#PhoneCodeBtn"));
                  return false;
           
             } else {
                 alert(res.errorMsg);
                  return false;
             }
         })
        
        return false;
         });

        $("#PhoneloginBtn").click(function () {
          var xtoken= $("#XToken").val();
        var phone = $("#pzlphone").val();
       var code = $("#pzlcode").val();
      
        
        if ((phone == "")||(code=="")) { alert("请输入手机号和验证码"); return false; }
             var data = {XToken:xtoken,xphone:phone,xcode:code};
    
      
       // var ww = "";
 //alert("加密后数据:"+ JSON.stringify(result));
         $.post('/zlineauthrize/xlogin/phonelogin?act=smslogin',data, function (res)
      
         {
             res = JSON.parse(res);
             if (res.succeed==1) {
                    window.location.href = "https://www.hsys.pudong-edu.sh.cn/infomng/images/pic2.gif??r="+xtoken;
               //  ww = "yy";
             } else {
                 alert(res.errorMsg);
                  return false;
             }
         })
          //  alert(ww);
        return true;
        });
    });

      var wait=60;
function time(o) {
if (wait == 0) {
o.removeAttr("disabled").text('重发短信验证码');
 
wait = 60;
} else {
o.attr("disabled", true).text(wait+"秒后重新获取");
wait--;
setTimeout(function() {
time(o)
},
1000)
}
}
    </script>
</head>

<body class="signin">
    <div class="signinpanel">
        <div class="row">
            <div class="col-sm-7">
                <div class="signin-info">
                     <!--<div class="logopanel m-b">
                        <h1>数字校园综合应用平台</h1>
                    </div>
                    <div class="m-b"></div>
                    <h4>欢迎使用 <strong>ZlineSystem</strong></h4>
                    
                   <strong>还没有账号？ <a href="#">立即注册&raquo;</a></strong>-->
                </div>
            </div>
            
            <div class="col-sm-5">
               
                       <div class="tabs-container">
                    <ul class="nav nav-tabs">
                        <li class="active"><a data-toggle="tab" href="#tab-1" aria-expanded="true">账号登录</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div id="tab-1" class="tab-pane active">
                            <div class="panel-body"> 
                   <!-- 
                    <p class="m-t-md">登录到ZlineSystem</p>-->
                    <input type="text" class="form-control uname" placeholder="用户名" name="pzlusername" id="pzlusername"/>
                    <input type="password" class="form-control pword m-b" placeholder="密码" name="pzlpassword" id="pzlpassword"/>
                    <!--<a href="">忘记密码了？</a>--><input type="hidden" value="1787721656_pz6A2BEDD2EE8ADD4A40F678A462E0CC17" name="xtoken" id="XToken"/>
                    <button class="btn btn-success btn-block" id="loginBtn">登录</button>
                 
                            </div>
                        </div>
                    </div>


                </div>
                
            </div>
        </div>
       <!-- <div class="signup-footer">
            <div class="pull-left">
                &copy; 2017 All Rights Reserved. 
            </div>
        </div>-->
    </div>
</body>

</html>

